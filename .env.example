[TEMPLATE]
# Copy to .env and adjust. Works with any Postgres (embedded local, Neon, Supabase…)
# Default below matches the embedded Postgres started by `npm run dev`.
# To use Neon/Supabase/etc., replace it with your own connection string.
TICKETFLOW_DATABASE_URL="postgresql://ticketflow:ticketflow@127.0.0.1:5434/ticketflow?schema=public"
JWT_SECRET="generate-a-long-random-string"
APP_URL="http://localhost:3000"

GATEWAY_MODE="MOCK"            # MOCK | RAZORPAY
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
